{
  "expo": {
    "name": "campus-connect-expo",
    "slug": "campus-connect-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/ToroConnectLogoCircle.png",
    "scheme": "campusconnectexpo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ivanjuarez.campusconnect",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A80532",
        "foregroundImage": "./assets/brand/ToroConnectLogoCircle.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/ToroConnectLogoCircle.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Campus Connect to record voice messages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Campus Connect to attach photos to messages."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/ToroConnectLogoCircle.png",
          "imageWidth": 560,
          "resizeMode": "contain",
          "backgroundColor": "#A80532",
          "dark": {
            "backgroundColor": "#120008"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61e70e49-f368-40ca-a884-5d709c4540f9"
      }
    }
  }
}
