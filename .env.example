# Backend (see campus-connect-server)
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8000

# Campus assistant (CSUN chatbot): same API as the web app — point at campus-connect-client /api/chat
# (uses GEMINI_API_KEY from the Next app’s .env / .env.local / .env.chatbot — not embedded in Expo).
# Example: http://192.168.1.10:3000/api/chat
EXPO_PUBLIC_CHAT_API_URL=
