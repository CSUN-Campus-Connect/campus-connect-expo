# Find your local IP: ifconfig | grep "inet " | grep -v 127.0.0.1
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8000/api

# CSUN Help chat — prefer your Next.js route (keeps the key on the server):
# EXPO_PUBLIC_CHAT_API_URL=http://localhost:3000/api/chat
# On a physical device, use your computer's LAN IP instead of localhost.

# Optional: direct Gemini from the app (key is bundled; dev only). Omit if using CHAT_API_URL.
# EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
